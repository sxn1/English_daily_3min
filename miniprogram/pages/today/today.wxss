.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 40rpx;
}

.badge {
  font-size: 32rpx;
  font-weight: 600;
  color: #A9662A;
}

.streak {
  font-size: 26rpx;
  color: #8A8377;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 10rpx 28rpx;
}

.card-theme {
  font-size: 26rpx;
  color: #8A8377;
  letter-spacing: 2rpx;
}

.card-chunk {
  margin-top: 24rpx;
  font-size: 64rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #3D3A33;
}

.card-chunk-cn {
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #A9662A;
}

.card-words {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
}

.word {
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #FFF6E5;
  color: #3D3A33;
  font-size: 28rpx;
}

.tips {
  margin: 48rpx 8rpx 40rpx;
}

.tips-line {
  font-size: 28rpx;
  color: #8A8377;
  line-height: 1.9;
}

.done {
  margin-top: 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #4CAF87;
}

.review {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A8377;
}

.next {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8A8377;
}

.dev {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #EFE4D2;
  text-align: center;
  font-size: 24rpx;
  color: #B9AE9C;
}
