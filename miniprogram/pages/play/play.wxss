.card-theme {
  font-size: 26rpx;
  color: #8A8377;
  letter-spacing: 2rpx;
}

.card-chunk {
  margin-top: 20rpx;
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 700;
}

.card-chunk-cn {
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #A9662A;
}

.audio-row {
  display: flex;
}

.audio-btn {
  flex: 1;
  padding: 32rpx 0;
  margin-right: 20rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  color: #3D3A33;
  font-size: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(180, 150, 110, 0.1);
}

.audio-btn:last-child {
  margin-right: 0;
}

.audio-btn.active {
  background: #FFE3C2;
  color: #A9662A;
}

.notice {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #8A8377;
  font-size: 26rpx;
  line-height: 1.7;
}

.script {
  padding: 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  font-size: 30rpx;
  line-height: 1.9;
  color: #3D3A33;
  box-shadow: 0 4rpx 16rpx rgba(180, 150, 110, 0.1);
}

.activity {
  padding: 32rpx 36rpx;
  margin-bottom: 20rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(180, 150, 110, 0.1);
}

.activity-en {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D3A33;
}

.activity-zh {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #8A8377;
}

.start {
  margin-top: 56rpx;
}

.timer {
  padding-top: 200rpx;
  text-align: center;
}

.timer-label {
  font-size: 36rpx;
  color: #A9662A;
}

.timer-value {
  margin-top: 40rpx;
  font-size: 160rpx;
  font-weight: 300;
  line-height: 1;
  color: #3D3A33;
  letter-spacing: 4rpx;
}

.timer-hint {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #8A8377;
}

.timer-chunk {
  margin-top: 120rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #3D3A33;
}

.timer-end {
  margin-top: 80rpx;
  font-size: 28rpx;
  color: #A9662A;
  text-decoration: underline;
}
